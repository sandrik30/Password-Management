<Window x:Class="PasswordManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:PasswordManager.Desktop"
        xmlns:ui="clr-namespace:PasswordManager.UI;assembly=PasswordManager.UI"
        Title="Password Manager" Width="1100" Height="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <blazor:BlazorWebView HostPage="wwwroot/index.html" Services="{x:Static local:App.Services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:AppRouter}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
